# 복사해서 .env 로 저장. 값은 절대 커밋하지 않는다 (.gitignore 가 .env 를 막는다).

# Slack 앱 설정 > OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=
# Slack 앱 설정 > Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=
# 내 슬랙 사용자 ID (프로필 > ⋯ > Copy member ID). 이 사람의 DM 에만 응답한다.
SLACK_OWNER_ID=

# 기억 레포 경로 (CLAUDE.md 가 있는 디렉토리). claude -p 가 이 디렉토리를 cwd 로 돈다.
MEMORY_DIR=../memory-template

# 선택
CLAUDE_BIN=claude
CLAUDE_MODEL=
CLAUDE_TIMEOUT_SEC=300
SESSION_IDLE_HOURS=8
